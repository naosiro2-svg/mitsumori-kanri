# Firebase Web App configuration
# 1. https://console.firebase.google.com/ で新規プロジェクトを作成
# 2. 「Authentication」>「Sign-in method」で Google を有効化
# 3. Google Cloud Console (同じプロジェクト) で
#    Google Sheets API / Google Drive API を有効化
# 4. Firebaseの「プロジェクトの設定」>「マイアプリ」でWebアプリを追加し、
#    表示された設定値を以下に貼り付けてください
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
